# Supabase-project voor Corpcase.
#
# De publieke sleutel is bewust het enige wat de app nodig heeft: toegang wordt in de database
# afgedwongen op basis van de deelnemertoken en de beheercode, niet op basis van deze sleutel.
#
# Richt een eigen project in met supabase/schema.sql en vul de twee waarden hieronder. Zonder deze
# variabelen valt de app terug op de offline modus, en is hij na `npm install && npm run dev`
# meteen speelbaar op één machine.
NEXT_PUBLIC_SUPABASE_URL=https://<jouw-project>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Forceert de offline modus, ook als de bovenstaande variabelen gevuld zijn. Bedoeld voor tests en
# als terugvaloptie op locatie waar het netwerk niet meewerkt.
# NEXT_PUBLIC_OPSLAG=lokaal
